<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/volunteer_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/volunteer_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/volunteer_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phone"
        android:textSize="16sp" />

    <Button
        android:id="@+id/button_view_availabilities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Voir les disponibilités" />

    <Button
        android:id="@+id/button_manage_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gérer l'utilisateur" />

    <Button
        android:id="@+id/button_view_plannings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Voir les plannings" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp" />
</LinearLayout>
