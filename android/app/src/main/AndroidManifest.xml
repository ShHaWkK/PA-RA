<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nomorewaste"
        tools:targetApi="31">

        <activity
            android:name="com.example.nomoreswaste.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nomorewaste.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.nomoreswaste.LoginActivity"
            android:exported="false"
            android:label="@string/title_login"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.RegisterVolunteerActivity"
            android:exported="false"
            android:label="Volunteer Registration"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.RegisterMerchantActivity"
            android:exported="false"
            android:label="Merchant Registration"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.espace.MerchantActivity"
            android:exported="false"
            android:label="Merchant Area"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.espace.VolunteerActivity"
            android:exported="false"
            android:label="Volunteer Area"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.UserManagementActivity"
            android:exported="false"
            android:label="User Management"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.PlanningsActivity"
            android:exported="false"
            android:label="Plannings"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.AvailabilitiesActivity"
            android:exported="false"
            android:label="Availabilities"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.UpdateNameActivity"
            android:exported="false"
            android:label="Update Name"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.UpdateEmailActivity"
            android:exported="false"
            android:label="Update Email"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.UpdatePhoneActivity"
            android:exported="false"
            android:label="Update Phone"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.UpdatePasswordActivity"
            android:exported="false"
            android:label="Update Password"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.InventoryActivity"
            android:exported="false"
            android:label="Inventory"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.RecipesActivity"
            android:exported="false"
            android:label="Recipes"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.SuggestMenuActivity"
            android:exported="false"
            android:label="Suggest Menu"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.ProductManagementActivity"
            android:exported="false"
            android:label="Product Management"
            android:theme="@style/Theme.Nomorewaste" />

        <activity
            android:name="com.example.nomorewaste.SelectProductsActivity"
            android:exported="true"
            android:label="Select Products"
            android:theme="@style/Theme.Nomorewaste" />

    </application>
</manifest>
